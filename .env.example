# Copy this file to .env and fill in real values. .env is git-ignored — nothing
# workspace-identifying (tokens, channel/user IDs) should ever be committed.

SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Comma-separated Slack member IDs, auto-invited to every /register-created channel.
# Find a member ID via their profile > "Copy member ID".
TEAM_LEADER_IDS=U0123ABCD,U0456EFGH

# Slack member ID always invited to every /register-created channel.
OWNER_ID=U0789IJKL

# Optional — currently unused by reminders, kept in case an admin/log channel is
# wanted later. Safe to leave unset.
REMINDER_CHANNEL_ID=
